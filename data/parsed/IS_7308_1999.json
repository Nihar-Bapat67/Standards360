{
  "clauses": [
    {
      "is": "IS 7308:1999",
      "clause": "1",
      "title": "Scope",
      "text": "1. Scope — Covers the requirements of three grades of non-coniferous logs, for conversion into sawn timber.",
      "clause_id": "IS 7308:1999#1",
      "family": "IS 7308",
      "year": 1999,
      "level": 1,
      "parent_clause": null,
      "role": "scope",
      "page_start": 180,
      "page_end": 180,
      "has_table": false,
      "flags": []
    },
    {
      "is": "IS 7308:1999",
      "clause": "2",
      "title": "Grades",
      "text": "2. Grades  — Grade I — No single log of length 2.5 m shall contain more than 3 units of defects Grade II— No single log of length 2.5 m shall contain more than 6 units of defects. Grade III— No single log of length 2.5 m shall contain more than 9 units of defects. For   logs  other  than  2.5 m in length, the limits given in above shall be derived by the following equation— Permissible number of defect in logs other than 2.5 m in length  = L/2.5×P Where L = length of log in m, and P = permissible defect value for 2.5 m length",
      "clause_id": "IS 7308:1999#2",
      "family": "IS 7308",
      "year": 1999,
      "level": 1,
      "parent_clause": null,
      "role": "other",
      "page_start": 180,
      "page_end": 180,
      "has_table": false,
      "flags": []
    },
    {
      "is": "IS 7308:1999",
      "clause": "3",
      "title": "Species",
      "text": "3. Species —  The logs shall be of the species of timber given in Appendix A of the standard.",
      "clause_id": "IS 7308:1999#3",
      "family": "IS 7308",
      "year": 1999,
      "level": 1,
      "parent_clause": null,
      "role": "other",
      "page_start": 180,
      "page_end": 180,
      "has_table": false,
      "flags": []
    },
    {
      "is": "IS 7308:1999",
      "clause": "4",
      "title": "Dimensions",
      "text": "4. Dimensions — The minimum dimensions of logs shall be the following : Length 2.5 m Mean mid-girth 1 m",
      "clause_id": "IS 7308:1999#4",
      "family": "IS 7308",
      "year": 1999,
      "level": 1,
      "parent_clause": null,
      "role": "requirements",
      "page_start": 180,
      "page_end": 180,
      "has_table": false,
      "flags": []
    },
    {
      "is": "IS 7308:1999",
      "clause": "5",
      "title": "Requirements",
      "text": "5 . Requirements — The logs shall not be knobbly. They shall be free from brashness, hollow centre, shatter, spiral grain, any kind of decay (rot), live insect attack and any other defects which may reduce the uefulness of logs for conversion into sawn timber.All buttresses, remnants of branches and large knots shall be trimmed flush with the bole of log. The two ends should be clean cut with a saw and shall be as close to the plane at right angles to the axis as possible.",
      "clause_id": "IS 7308:1999#5",
      "family": "IS 7308",
      "year": 1999,
      "level": 1,
      "parent_clause": null,
      "role": "requirements",
      "page_start": 180,
      "page_end": 180,
      "has_table": false,
      "flags": []
    },
