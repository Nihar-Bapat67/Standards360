    {
      "is": "IS 4895:1985",
      "clause": "1",
      "title": "Scope",
      "text": "1. Scope — Covers the requiremens of various grades of teak logs intended for conversion purposes. It does not cover the requirements of teak logs for veneering purposes.",
      "clause_id": "IS 4895:1985#1",
      "family": "IS 4895",
