      "is": "IS 5246:2000",
      "clause": "1",
      "title": "Scope",
      "text": "1. Scope  —  Covers the requirements of three grades of coniferous logs, that is, Grade 1, Grade 2 and Grade 3, for conversion into timber.",
      "clause_id": "IS 5246:2000#1",
      "family": "IS 5246",
      "year": 2000,
      "level": 1,
      "parent_clause": null,
      "role": "scope",
      "page_start": 177,
      "page_end": 177,
      "has_table": false,
      "flags": []
    },
    {
      "is": "IS 5246:2000",
      "clause": "2",
      "title": "Grades",
      "text": "2. Grades Grade 1— 6 minor defects or 2 major and 2 minor defects. Grade 2— 9 minor defects or 3 major and 3 minor defects. Grade 3— 12 minor defects or 3 major and 6 minor defects.",
      "clause_id": "IS 5246:2000#2",
      "family": "IS 5246",
      "year": 2000,
      "level": 1,
      "parent_clause": null,
      "role": "other",
