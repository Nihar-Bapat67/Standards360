    },
    {
      "is": "IS 5246:2000",
      "clause": "3",
      "title": "Species",
      "text": "3. Species —The logs shall be of the species of timber listed below— Trade Name Botanical Name             Abbreviation Fr Abies pindrow Royale                FIR Deodar          Cedrus deodara  D.Don DEO Cypress         Cupressus torulasa D.Don CYP Spruce           Picea Smithiana Boiss SPR Kail            Pinus excelsa Wall KAL Khasi Pine      Pinus Khasya Royle KPI Chir              Pinus Roxburg Sargent CHR",
      "clause_id": "IS 5246:2000#3",
      "family": "IS 5246",
      "year": 2000,
      "level": 1,
      "parent_clause": null,
      "role": "other",
      "page_start": 177,
      "page_end": 177,
      "has_table": false,
      "flags": []
    },
    {
      "is": "IS 5246:2000",
      "clause": "4",
      "title": "Dimensions",
      "text": "4. Dimensions Minimum length 2.5 m Minimum mean mid-girth 1    m",
      "clause_id": "IS 5246:2000#4",
      "family": "IS 5246",
      "year": 2000,
      "level": 1,
      "parent_clause": null,
      "role": "requirements",
