      "flags": []
    },
    {
      "is": "IS 5246:2000",
      "clause": "5",
      "title": "Requirements",
      "text": "5. Requirements  —  The logs shall be free from hollow centre above 15percent of the basal area of the log, spiral grain, any kind of decay (rot), insect attack and any other defects (except those permitted  in 6 below). The hollow centre throughout the length of the long shall not be permitted.",
      "clause_id": "IS 5246:2000#5",
