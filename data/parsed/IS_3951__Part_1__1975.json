      ]
    },
    {
      "is": "IS 3951 (Part 1):1975",
      "clause": "2.1",
      "title": "Winding or Bowing",
      "text": "2.1 Winding or Bowing —  Shall be not more than 5 mm per 30 cm length or width.",
      "clause_id": "IS 3951 (Part 1):1975#2.1",
      "family": "IS 3951 (Part 1)",
      "year": 1975,
      "level": 2,
      "parent_clause": "2",
      "role": "other",
