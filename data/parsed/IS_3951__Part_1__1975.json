    {
      "is": "IS 3951 (Part 1):1975",
      "clause": "2",
      "title": "General Requirements",
      "text": "2. General Requirements — Shall be free from cracks, flaws and nodules of free lime. Shall be of uniform colour and shall have plane rectangular faces with parallel sides and straight right angled edges.",
      "clause_id": "IS 3951 (Part 1):1975#2",
      "family": "IS 3951 (Part 1)",
      "year": 1975,
      "level": 1,
      "parent_clause": null,
      "role": "requirements",
