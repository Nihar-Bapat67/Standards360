      "clause": "2.2",
      "title": "Concavity or Convexity",
      "text": "2.2 Concavity or Convexity — Shall be not more than 5 mm per 30 cm  run at any point on either diagonal.",
      "clause_id": "IS 3951 (Part 1):1975#2.2",
      "family": "IS 3951 (Part 1)",
      "year": 1975,
      "level": 2,
