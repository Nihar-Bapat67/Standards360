      "is": "IS 2191 (Part 2):1983",
      "clause": "5.1",
      "title": "Face Panels",
      "text": "5.1 Face Panels — Particle board or veneered particle board shall not be less than 6 mm thick for cellular core and not less than 9 mm thick for hollow core shutters. Hardboard thickness shall not be less than 4 mm for cellular core and not less than 6 mm for hollow core shutters.",
      "clause_id": "IS 2191 (Part 2):1983#5.1",
      "family": "IS 2191 (Part 2)",
      "year": 1983,
