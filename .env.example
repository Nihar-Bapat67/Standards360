# Standards360 — environment
#
# Copy to `.env` in the repository root and fill in what you have. Every value here is optional:
# the engine runs with none of them, and says so rather than failing.
#
# `.env` is git-ignored. Never commit a real key.

# ── Language model (optional) ────────────────────────────────────────────────
# Hosted-model calls are disabled unless you have confirmed that the selected provider's terms
# guarantee no retention for tender/specification data. Set this true only after that review.
LLM_NO_RETENTION_CONFIRMED=false

# Provider options: sarvam, openai, gemini, groq, openrouter. Sarvam remains the default.
LLM_PROVIDER=sarvam
LLM_API_KEY=
LLM_MODEL=sarvam-105b-conversations
LLM_BASE_URL=https://api.sarvam.ai

# SARVAM_API_KEY is also used by B2 translation. The general LLM settings above select its chat model.
SARVAM_API_KEY=

# Translates the public web-interface dictionary at runtime; keep this key on the API server only.
GOOGLE_TRANSLATE_API_KEY=

# ── Collector politeness (optional) ──────────────────────────────────────────
# Added to the User-Agent of the A1 collector so BIS can contact you about the crawl. Courtesy,
# not authentication.
BIS_CONTACT=

# ── Web interface (optional) ─────────────────────────────────────────────────
# Leave unset in both normal setups. In development Vite proxies /v1 to the API on port 8000; in
# production FastAPI serves the built interface itself, so both share an origin.
# Set it only when the interface and the API are deployed to different hosts.
# VITE_API_BASE=https://api.example.gov.in

# ── Deployment (optional) ────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser. Only needed when the interface and
# the API are on different hosts; when this process serves the built interface they share an origin
# and CORS is never used. Defaults to "*", which is right for local development.
# STANDARDS360_ORIGINS=https://gem.gov.in,https://eprocure.gov.in
